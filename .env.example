# ==============================================================================
# TALENTPULSE AI — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Settings
PORT=8080
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Google Gemini API (Google AI Studio)
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud & Firestore Settings
# Lấy từ Google Cloud Console
GCP_PROJECT_ID=your_gcp_project_id_here
FIRESTORE_DATABASE=(default)

# Firebase Admin SDK Configuration
# Đường dẫn tới file JSON Service Account hoặc chuỗi JSON
# Tải tại: Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=backend/credentials/firebase-adminsdk.json

# Firebase Web App Config (Dùng cho Frontend đăng nhập)
# Lấy tại: Firebase Console -> Project Settings -> General -> Your Apps
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_WEB_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your_gcp_project_id_here
FIREBASE_WEB_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_WEB_APP_ID=your_firebase_app_id
